#!/bin/bash

# omarchy:summary=Print the hardware platform Omarchy is running on (apple-silicon, raspberry-pi-5, raspberry-pi, cix-sky1, pinebook-pro, generic-aarch64 or x86_64).
# omarchy:examples=omarchy hw platform

# Detection reads the flattened device tree, which is where every aarch64
# board describes itself. x86 machines have no device tree and are reported
# from uname alone, so this stays safe to call on the ISO's own hardware.

arch="${OMARCHY_ARCH:-$(uname -m)}"
devicetree="${OMARCHY_DEVICETREE:-/proc/device-tree}"

if [[ $arch != "aarch64" && $arch != "arm64" ]]; then
  echo "$arch"
  exit 0
fi

# The compatible property is a NUL-separated list, most specific entry first.
compatible=""
[[ -r $devicetree/compatible ]] && compatible=$(tr '\0' '\n' <"$devicetree/compatible" | tr '\n' ' ')

model=""
[[ -r $devicetree/model ]] && model=$(tr -d '\0' <"$devicetree/model")

case "$compatible " in
  *"apple,arm-platform "*)
    echo "apple-silicon"
    exit 0
    ;;
  *"raspberrypi,5-"*|*"brcm,bcm2712 "*)
    echo "raspberry-pi-5"
    exit 0
    ;;
  *"raspberrypi,"*|*"brcm,bcm27"*)
    echo "raspberry-pi"
    exit 0
    ;;
  *"cix,sky1 "*)
    echo "cix-sky1"
    exit 0
    ;;
  *"pine64,pinebook-pro "*)
    echo "pinebook-pro"
    exit 0
    ;;
esac

# Asahi kernels that predate the apple,arm-platform compatible still name the
# machine in the model string ("Apple MacBook Pro (13-inch, M1, 2020)").
case "$model" in
  Apple*)
    echo "apple-silicon"
    exit 0
    ;;
  "Raspberry Pi 5"*)
    echo "raspberry-pi-5"
    exit 0
    ;;
  "Raspberry Pi"*)
    echo "raspberry-pi"
    exit 0
    ;;
  "Pine64 Pinebook Pro"*)
    echo "pinebook-pro"
    exit 0
    ;;
esac

# ACPI-only boards have no device tree at all. The CIX Sky1 (CP8180/CD8180:
# the Minisforum MS-R1, and the Radxa Orion O6 booted in ACPI mode) names its
# display engines CIXH5010 in the DSDT, one platform device per output.
platform_devices="${OMARCHY_PLATFORM_DEVICES:-/sys/bus/platform/devices}"
if compgen -G "$platform_devices/CIXH5010:*" >/dev/null; then
  echo "cix-sky1"
  exit 0
fi

echo "generic-aarch64"
