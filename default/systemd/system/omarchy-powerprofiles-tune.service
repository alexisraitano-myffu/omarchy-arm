[Unit]
Description=Apply the kernel side of the active power profile
After=power-profiles-daemon.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
ExecStart=/usr/bin/omarchy-powerprofiles-tune

[Install]
# power-profiles-daemon orders itself after multi-user.target (0.30), so
# multi-user.target cannot wait for this unit: the cycle makes systemd drop it.
WantedBy=graphical.target
